{
  "name": "kpaperaddon kclock",
  "author": "kriaiss",
  "version": "1.0.1",
  "description": "clean desktop clock with date, weather and <<now playing>>; nowplaying-cli required",
  "dependencies": [
    "pyobjc-framework-cocoa",
    "pyqt6"
  ],
  "settings": [
    "toggle clock",
    "toggle date",
    "toggle weather",
    "toggle now playing",
    "toggle time format",
    "change city",
    "change color",
    "change clock font",
    "change other font"
  ]
}